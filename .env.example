# Ledgerloop Configuration

# --- Agent ---
LEDGERLOOP_LOG_LEVEL=INFO
LEDGERLOOP_ENV=development

# --- Memory ---
LEDGERLOOP_MEMORY_BACKEND=sqlite
LEDGERLOOP_MEMORY_DSN=sqlite+aiosqlite:///ledgerloop.db

# --- LLM (when connecting to providers) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Observability ---
LEDGERLOOP_TRACING_ENABLED=true
LEDGERLOOP_METRICS_ENABLED=true

# --- Auth ---
LEDGERLOOP_AUTH_ENABLED=false
LEDGERLOOP_API_KEY=
